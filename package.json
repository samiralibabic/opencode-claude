{
  "name": "@samiralibabic/opencode-claude",
  "version": "0.15.1",
  "description": "Claude Code in OpenCode 1 — a maintained fork of @openchamber/opencode-claude 0.14.0: local CLI auth, Agent SDK harness, effort variants, tools/MCP, images, several Claude accounts, parallel subagents.",
  "license": "MIT",
  "type": "module",
  "main": "./opencode-claude.js",
  "module": "./opencode-claude.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./opencode-claude.js",
      "default": "./opencode-claude.js"
    }
  },
  "files": [
    "dist",
    "opencode-claude.js"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "bun test/model-discovery.ts && bun test/smoke.ts && bun test/bridge-contract.ts && bun test/cancel-teardown-regression.ts && bun test/accounts.ts && bun test/parallel-tools-regression.ts && bun test/error-step-usage.ts",
    "test:haiku": "bun test/haiku-live.ts",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samiralibabic/opencode-claude.git"
  },
  "homepage": "https://github.com/samiralibabic/opencode-claude",
  "bugs": {
    "url": "https://github.com/samiralibabic/opencode-claude/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude",
    "claude-code",
    "anthropic",
    "oauth",
    "agent-sdk",
    "openai-compatible",
    "ai",
    "llm",
    "streaming",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@opencode-ai/plugin": "^1.18.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
